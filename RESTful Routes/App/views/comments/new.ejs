<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Comments Submission Form</title>
</head>

<body>

    <div class="container">

        <form action="/comments" method="post">
            <h1>Submit your comment below</h1>
            <section>
                <label for="username">Username</label>
                <input type="text" name="username" id="username" placeholder="username">
            </section>
            <br>
            <br>
            <section>
                <label for="comment">Comment</label>
                <textarea name="comment" id="comment" placeholder="Enter your comment here" cols="30"
                    rows="5"></textarea>
            </section>
            <br>
            <br>
            <section>
                <button>Submit</button>
            </section>
        </form>

    </div>

</body>

</html>