<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= product.name %>
    </title>
</head>

<body>
    <h1>
        <%= product.name %>
    </h1>
    <ul>
        <li>Price: $<%= product.price %>
        </li>
        <li>Category: <%= product.category %>
        </li>
    </ul>
    <a href="/products">Go back to the Products page</a>
    <br>
    <a href="/products/<%= product._id %>/edit">Edit this item</a>

</body>

</html>